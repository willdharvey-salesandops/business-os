{
  "crons": [
    {
      "path": "/api/content-pipeline/check-drive",
      "schedule": "30 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "emailshepherd.vercel.app"
        }
      ],
      "destination": "/outreach-console/"
    }
  ]
}